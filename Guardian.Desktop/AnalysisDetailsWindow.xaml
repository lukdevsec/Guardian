<Window
    x:Class="Guardian.Desktop.AnalysisDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#101827">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================= -->
        <!-- HEADER -->
        <!-- ================================= -->

        <Border
            Grid.Row="0"
            Background="#19263A"
            Padding="24,22">

            <StackPanel Spacing="12">

                <Grid ColumnDefinitions="*,Auto">

                    <StackPanel Spacing="5">

                        <TextBlock
                            Text="GUARDIAN INTELLIGENCE"
                            FontSize="11"
                            CharacterSpacing="120"
                            Foreground="#83DFC2"/>

                        <TextBlock
                            Text="Security Analysis Report"
                            FontSize="25"
                            FontWeight="Bold"
                            Foreground="White"/>

                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Content="Copy report"
                        Click="CopyReportButton_Click"
                        VerticalAlignment="Center"
                        Background="#334760"
                        Foreground="White"
                        Padding="14,10"
                        CornerRadius="8"/>

                </Grid>

                <TextBlock
                    x:Name="ReportTimestampText"
                    FontSize="12"
                    Foreground="#96AAC3"/>

            </StackPanel>

        </Border>

        <!-- ================================= -->
        <!-- ANALYSIS TABS -->
        <!-- ================================= -->

        <TabView
            Grid.Row="1"
            Margin="16,12"
            IsAddTabButtonVisible="False">

            <!-- ============================= -->
            <!-- OVERVIEW -->
            <!-- ============================= -->

            <TabViewItem
                Header="Overview"
                IsClosable="False">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel
                        Padding="8,16,8,24"
                        Spacing="16">

                        <!-- WEBSITE SUMMARY -->

                        <Border
                            Background="#1B2A40"
                            CornerRadius="12"
                            Padding="20">

                            <StackPanel Spacing="14">

                                <TextBlock
                                    Text="WEBSITE"
                                    FontSize="10"
                                    CharacterSpacing="100"
                                    Foreground="#83DFC2"/>

                                <TextBlock
                                    x:Name="ReportDomainText"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    x:Name="ReportBrowserText"
                                    FontSize="12"
                                    Foreground="#9BAFC8"/>

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        Text="RISK ASSESSMENT"
                                        FontSize="11"
                                        Foreground="#B8C8DB"
                                        VerticalAlignment="Center"/>

                                    <Border
                                        x:Name="ReportRiskBadge"
                                        Grid.Column="1"
                                        Background="#3A4B60"
                                        Padding="16,8"
                                        CornerRadius="9">

                                        <TextBlock
                                            x:Name="ReportRiskText"
                                            Text="UNKNOWN"
                                            FontWeight="Bold"
                                            Foreground="White"/>

                                    </Border>

                                </Grid>

                                <TextBlock
                                    x:Name="ReportScoreText"
                                    Text="--/100"
                                    FontSize="36"
                                    FontWeight="Bold"
                                    Foreground="White"/>

                                <TextBlock
                                    x:Name="ReportSummaryText"
                                    FontSize="13"
                                    Foreground="#C6D3E2"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                        <!-- ANALYSIS INFORMATION -->

                        <Border
                            Background="#1B2A40"
                            CornerRadius="12"
                            Padding="20">

                            <StackPanel Spacing="12">

                                <TextBlock
                                    Text="ANALYSIS INFORMATION"
                                    FontSize="11"
                                    CharacterSpacing="100"
                                    Foreground="#83DFC2"/>

                                <TextBlock
                                    x:Name="ReportSourceText"
                                    Foreground="#D4DFEC"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Text="Current engine: URL heuristics + local OCR"
                                    FontSize="12"
                                    Foreground="#A6B8CF"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Text="This assessment is not a guarantee of website safety."
                                    FontSize="12"
                                    Foreground="#A6B8CF"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabViewItem>

            <!-- ============================= -->
            <!-- EVIDENCE -->
            <!-- ============================= -->

            <TabViewItem
                Header="Evidence"
                IsClosable="False">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel
                        Padding="8,16,8,24"
                        Spacing="16">

                        <!-- VERIFIED BROWSER ADDRESS -->

                        <Border
                            Background="#1B2A40"
                            CornerRadius="12"
                            Padding="20">

                            <StackPanel Spacing="12">

                                <TextBlock
                                    Text="ACTIVE BROWSER ADDRESS"
                                    FontSize="11"
                                    CharacterSpacing="100"
                                    Foreground="#83DFC2"/>

                                <TextBox
                                    x:Name="ReportActiveUrlText"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    MinHeight="55"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    Background="#111C2D"
                                    Foreground="White"/>

                                <TextBlock
                                    Text="Address read from the browser interface using UI Automation. This does not verify the website's reputation."
                                    FontSize="11"
                                    Foreground="#9BAFC8"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                        <!-- DETECTION REASONS -->

                        <Border
                            Background="#1B2A40"
                            CornerRadius="12"
                            Padding="20">

                            <StackPanel Spacing="12">

                                <TextBlock
                                    Text="DETECTION REASONS"
                                    FontSize="11"
                                    CharacterSpacing="100"
                                    Foreground="#83DFC2"/>

                                <TextBlock
                                    x:Name="ReportReasonsText"
                                    FontSize="13"
                                    Foreground="#D5E0ED"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                        <!-- OCR URL CANDIDATES -->

                        <Border
                            Background="#1B2A40"
                            CornerRadius="12"
                            Padding="20">

                            <StackPanel Spacing="12">

                                <TextBlock
                                    Text="UNVERIFIED OCR URL CANDIDATES"
                                    FontSize="11"
                                    CharacterSpacing="100"
                                    Foreground="#83DFC2"/>

                                <TextBox
                                    x:Name="ReportOcrUrlsText"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    MinHeight="80"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    Background="#111C2D"
                                    Foreground="#C7D5E5"/>

                                <TextBlock
                                    Text="These URL candidates were extracted from screen pixels and may contain OCR errors."
                                    FontSize="11"
                                    Foreground="#9BAFC8"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabViewItem>

            <!-- ============================= -->
            <!-- RECOGNIZED SCREEN CONTENT -->
            <!-- ============================= -->

            <TabViewItem
                Header="Recognized text"
                IsClosable="False">

                <Grid Padding="8,16,8,16">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- OCR HEADER -->

                    <StackPanel
                        Grid.Row="0"
                        Spacing="5"
                        Margin="0,0,0,12">

                        <TextBlock
                            Text="RAW OCR OUTPUT"
                            FontSize="11"
                            CharacterSpacing="100"
                            Foreground="#83DFC2"/>

                        <TextBlock
                            Text="Text extracted from the selected browser window. Recognition errors may occur."
                            FontSize="12"
                            Foreground="#A6B8CF"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                    <!-- SCROLLABLE OCR TEXT -->

                    <TextBox
                        x:Name="ReportOcrText"
                        Grid.Row="1"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        Background="#162338"
                        Foreground="#D7E2F0"
                        FontFamily="Consolas"
                        FontSize="12"
                        Padding="16"/>

                    <!-- COPY BUTTON -->

                    <Button
                        Grid.Row="2"
                        Content="Copy recognized text"
                        Click="CopyOcrButton_Click"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Background="#334760"
                        Foreground="White"
                        Padding="16,10"
                        CornerRadius="8"/>

                </Grid>

            </TabViewItem>

            <!-- ============================= -->
            <!-- CLOUD AI ANALYSIS -->
            <!-- ============================= -->

            <TabViewItem
                Header="Cloud AI"
                IsClosable="False">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel
                        Padding="8,16,8,24"
                        Spacing="16">

                        <Border
                            Background="#1B2A40"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Text="CLAUDE SECURITY ASSESSMENT"
                                    FontSize="11"
                                    CharacterSpacing="100"
                                    Foreground="#83DFC2"/>

                                <TextBlock
                                    x:Name="ReportAiVerdictText"
                                    Text="Not analyzed"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="White"/>

                                <TextBlock
                                    x:Name="ReportAiConfidenceText"
                                    Text="Confidence: N/A"
                                    FontSize="13"
                                    Foreground="#B8C8DB"/>

                                <TextBlock
                                    x:Name="ReportAiModelText"
                                    Text="Model: Not used"
                                    FontSize="11"
                                    Foreground="#91A9C4"/>

                                <TextBlock
                                    x:Name="ReportAiDomainText"
                                    Text="Domain registry: Not checked"
                                    FontSize="12"
                                    Foreground="#83DFC2"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    x:Name="ReportAiSummaryText"
                                    Text="Run Cloud AI analysis from Guardian Vision to see the contextual assessment."
                                    FontSize="13"
                                    Foreground="#D5E0ED"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#1B2A40"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Text="AI INDICATORS"
                                    FontSize="11"
                                    CharacterSpacing="100"
                                    Foreground="#83DFC2"/>

                                <TextBlock
                                    x:Name="ReportAiIndicatorsText"
                                    FontSize="13"
                                    Foreground="#D5E0ED"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="#1B2A40"
                            CornerRadius="12"
                            Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Text="RECOMMENDED ACTION"
                                    FontSize="11"
                                    CharacterSpacing="100"
                                    Foreground="#83DFC2"/>

                                <TextBlock
                                    x:Name="ReportAiActionText"
                                    FontSize="13"
                                    Foreground="#D5E0ED"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    x:Name="ReportAiUsageText"
                                    FontSize="11"
                                    Foreground="#91A9C4"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Text="Cloud AI is an additional advisory assessment. It does not replace local heuristics, verify domain reputation, or guarantee that a website is safe."
                            FontSize="11"
                            Foreground="#91A9C4"
                            TextWrapping="Wrap"/>

                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

        </TabView>

    </Grid>

</Window>
