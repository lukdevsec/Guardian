<Page
    x:Class="Guardian.Desktop.Pages.ModulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#0B1424">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="30,26,30,34" Spacing="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="GUARDIAN INTELLIGENCE" FontSize="10"
                               CharacterSpacing="130" Foreground="#77DCC1" />
                    <TextBlock x:Name="ModuleTitleText" Text="Security module"
                               FontSize="29" FontWeight="Bold" Foreground="White" />
                    <TextBlock x:Name="ModuleDescriptionText" FontSize="13"
                               Foreground="#9DB3CE" TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="#17283E" BorderBrush="#2B4C6D" BorderThickness="1"
                        CornerRadius="14" Padding="18">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="MODULE STATUS" FontSize="10"
                                           CharacterSpacing="110" Foreground="#77DCC1" />
                                <TextBlock x:Name="ModuleStatusText" FontSize="13"
                                           Foreground="#D5E0ED" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh" Click="RefreshButton_Click"
                                    Background="#304760" Foreground="White" Padding="13,8"
                                    CornerRadius="8" VerticalAlignment="Center" />
                        </Grid>
                        <TextBox x:Name="ModuleSearchBox" PlaceholderText="Filter by process, PID, domain or event..."
                                 TextChanged="ModuleSearchBox_TextChanged"
                                 Background="#101F33" Foreground="White"
                                 BorderBrush="#355574" PlaceholderForeground="#829BB8"
                                 Padding="10,8" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ModuleItemsPanel" Spacing="10" />

                <TextBlock Text="GUARDIAN · LOCAL DEVICE DATA" FontSize="10"
                           CharacterSpacing="90" Foreground="#637D9B"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
