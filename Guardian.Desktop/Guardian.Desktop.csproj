<Project Sdk="Microsoft.NET.Sdk">

	<!-- APPLICATION CONFIGURATION -->

	<PropertyGroup>
		<OutputType>WinExe</OutputType>

		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

		<RootNamespace>Guardian.Desktop</RootNamespace>

		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\GuardianIcon.ico</ApplicationIcon>

		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

		<PublishProfile>win-$(Platform).pubxml</PublishProfile>

		<UseWinUI>true</UseWinUI>
		<WinUISDKReferences>false</WinUISDKReferences>

		<EnableMsixTooling>true</EnableMsixTooling>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- WINDOWS / MSIX ICON ASSETS -->

	<ItemGroup>

		<!-- Include every PNG icon and its scale/targetsize variants. -->
		<Content Include="Assets\**\*.png" />

		<!-- Include the Windows executable/window icon. -->
		<Content Include="Assets\GuardianIcon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

	</ItemGroup>

	<!-- APPLICATION MANIFEST -->

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<!-- MSIX PROJECT CAPABILITY -->

	<ItemGroup
	  Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true'
    and '$(EnableMsixTooling)' == 'true'">

		<ProjectCapability Include="Msix" />

	</ItemGroup>

	<!-- NUGET PACKAGES -->

	<ItemGroup>

		<PackageReference
		  Include="FlaUI.UIA3"
		  Version="5.0.0" />

		<PackageReference
		  Include="Microsoft.Graphics.Win2D"
		  Version="1.4.0" />

		<PackageReference
		  Include="Microsoft.Windows.SDK.BuildTools"
		  Version="10.0.28000.2957" />

		<PackageReference
		  Include="Microsoft.WindowsAppSDK"
		  Version="2.6.5" />

		<PackageReference
		  Include="RapidOcrNet"
		  Version="4.2.0" />

		<PackageReference
		  Include="WinUIEx"
		  Version="2.9.3" />

		<PackageReference
		  Include="Microsoft.Extensions.Hosting"
		  Version="10.0.14" />

	</ItemGroup>

	<!-- PACKAGE AND PUBLISH -->

	<PropertyGroup
	  Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)' != 'true'
    and '$(EnableMsixTooling)' == 'true'">

		<HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>

	</PropertyGroup>

	<!-- PUBLISH CONFIGURATION -->

	<PropertyGroup>

		<PublishReadyToRun
		  Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>

		<PublishReadyToRun
		  Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>

		<PublishTrimmed
		  Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>

		<PublishTrimmed
		  Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>

	</PropertyGroup>

	<!-- PROJECT REFERENCES -->

	<ItemGroup>

		<ProjectReference
		  Include="..\Guardian.Service\Guardian.Service.csproj" />

	</ItemGroup>

	<!-- RAPID OCR MODELS -->

	<ItemGroup>

		<Content
		  Include="$(NuGetPackageRoot)rapidocrnet\4.2.0\models\v5\**\*">

			<Link>models\v5\%(RecursiveDir)%(Filename)%(Extension)</Link>

			<TargetPath>models\v5\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>

			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>

		</Content>

	</ItemGroup>

	<!-- XAML -->

	<ItemGroup>

		<None Remove="AnalysisDetailsWindow.xaml" />

	</ItemGroup>

	<ItemGroup>

		<Page Update="AnalysisDetailsWindow.xaml">

			<Generator>MSBuild:Compile</Generator>

		</Page>

	</ItemGroup>

	<!-- COPY RAPID OCR MODELS INTO APPX -->

	<Target
	  Name="CopyRapidOcrModelsIntoAppX"
	  AfterTargets="Build">

		<ItemGroup>

			<_RapidOcrModel
			  Include="$(NuGetPackageRoot)rapidocrnet\4.2.0\models\v5\**\*" />

		</ItemGroup>

		<Copy
		  SourceFiles="@(_RapidOcrModel)"
		  DestinationFiles="@(_RapidOcrModel->'$(OutDir)AppX\models\v5\%(RecursiveDir)%(Filename)%(Extension)')"
		  SkipUnchangedFiles="true" />

		<Message
		  Text="Guardian OCR models copied into AppX."
		  Importance="high" />

	</Target>

</Project>
