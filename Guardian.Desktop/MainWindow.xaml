<Window
    x:Class="Guardian.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#121D2D">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Padding="20,22,20,26"
                Spacing="16">

                <!-- ================================= -->
                <!-- HEADER -->
                <!-- ================================= -->

                <Grid ColumnDefinitions="*,Auto">

                    <StackPanel Spacing="4">

                        <TextBlock
                            Text="GUARDIAN"
                            FontSize="23"
                            FontWeight="Bold"
                            Foreground="White"
                            CharacterSpacing="110"/>

                        <TextBlock
                            Text="Endpoint Security Intelligence"
                            FontSize="11"
                            Foreground="#97AAC3"/>

                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Background="#263C4E"
                        CornerRadius="9"
                        Padding="10,6"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="PROTECTION"
                            FontSize="9"
                            Foreground="#82E2BD"
                            FontWeight="SemiBold"/>

                    </Border>

                </Grid>

                <!-- ================================= -->
                <!-- ENDPOINT MONITORING -->
                <!-- ================================= -->

                <Border
                    Background="#1E2D43"
                    CornerRadius="13"
                    Padding="16">

                    <StackPanel Spacing="10">

                        <!-- MODULE HEADER -->

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock
                                Text="ENDPOINT MONITORING"
                                FontSize="10"
                                CharacterSpacing="100"
                                Foreground="#82E2BD"
                                VerticalAlignment="Center"/>

                            <Button
                                Grid.Column="1"
                                Content="ⓘ  Info"
                                Click="EndpointInfoButton_Click"
                                Background="#2C415B"
                                Foreground="#BDEBFF"
                                FontSize="11"
                                Padding="10,6"
                                CornerRadius="8"/>

                        </Grid>

                        <!-- STATUS -->

                        <TextBlock
                            x:Name="StatusText"
                            Text="Monitoring starting"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                        <TextBlock
                            x:Name="StatusDescription"
                            TextWrapping="Wrap"
                            FontSize="11"
                            Foreground="#A7BAD2"/>

                        <!-- COUNTERS -->

                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="8">

                            <!-- PROCESSES -->

                            <Border
                                Background="#172235"
                                CornerRadius="9"
                                Padding="9">

                                <StackPanel Spacing="5">

                                    <TextBlock
                                        Text="PROCESSES"
                                        FontSize="9"
                                        Foreground="#9DB2CE"/>

                                    <TextBlock
                                        x:Name="ProcessesText"
                                        Text="0"
                                        FontSize="19"
                                        FontWeight="Bold"
                                        Foreground="White"/>

                                </StackPanel>

                            </Border>

                            <!-- TCP CONNECTIONS -->

                            <Border
                                Grid.Column="1"
                                Background="#172235"
                                CornerRadius="9"
                                Padding="9">

                                <StackPanel Spacing="5">

                                    <TextBlock
                                        Text="TCP"
                                        FontSize="9"
                                        Foreground="#9DB2CE"/>

                                    <TextBlock
                                        x:Name="ConnectionsText"
                                        Text="0"
                                        FontSize="19"
                                        FontWeight="Bold"
                                        Foreground="White"/>

                                </StackPanel>

                            </Border>

                            <!-- ALERTS -->

                            <Border
                                Grid.Column="2"
                                Background="#172235"
                                CornerRadius="9"
                                Padding="9">

                                <StackPanel Spacing="5">

                                    <TextBlock
                                        Text="ALERTS"
                                        FontSize="9"
                                        Foreground="#9DB2CE"/>

                                    <TextBlock
                                        x:Name="AlertsText"
                                        Text="0"
                                        FontSize="19"
                                        FontWeight="Bold"
                                        Foreground="White"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                        <!-- LATEST EVENT -->

                        <TextBlock
                            x:Name="LatestEventText"
                            FontSize="11"
                            Foreground="#A7BAD2"
                            TextWrapping="Wrap"
                            MaxLines="3"/>

                        <!-- REFRESH -->

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock
                                x:Name="UpdatedText"
                                FontSize="10"
                                Foreground="#8196AF"
                                VerticalAlignment="Center"/>

                            <Button
                                Grid.Column="1"
                                Content="Refresh"
                                Click="RefreshButton_Click"
                                Background="#344760"
                                Foreground="White"
                                Padding="12,6"
                                CornerRadius="7"/>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- ================================= -->
                <!-- GUARDIAN VISION -->
                <!-- ================================= -->

                <Border
                    Background="#203149"
                    CornerRadius="13"
                    Padding="16">

                    <StackPanel Spacing="12">

                        <!-- MODULE HEADER -->

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock
                                Text="GUARDIAN VISION"
                                FontSize="10"
                                CharacterSpacing="110"
                                Foreground="#82E2BD"
                                VerticalAlignment="Center"/>

                            <Button
                                Grid.Column="1"
                                Content="ⓘ  Info"
                                Click="VisionInfoButton_Click"
                                Background="#2C415B"
                                Foreground="#BDEBFF"
                                FontSize="11"
                                Padding="10,6"
                                CornerRadius="8"/>

                        </Grid>

                        <!-- TITLE -->

                        <TextBlock
                            Text="Website Security Analysis"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                        <TextBlock
                            Text="Analyze browser content locally and inspect suspicious website indicators."
                            FontSize="11"
                            TextWrapping="Wrap"
                            Foreground="#A8BBD2"/>

                        <!-- MANUAL ANALYSIS -->

                        <Button
                            Content="Analyze selected window"
                            Click="AnalyzeScreenButton_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#286B91"
                            Foreground="White"
                            Padding="14,12"
                            CornerRadius="9"/>

                        <!-- CONTINUOUS MONITORING -->

                        <Button
                            x:Name="ContinuousVisionButton"
                            Content="Start continuous monitoring"
                            Click="ContinuousVisionButton_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#247A68"
                            Foreground="White"
                            Padding="14,12"
                            CornerRadius="9"/>

                        <TextBlock
                            x:Name="ContinuousVisionStatusText"
                            Text="Continuous monitoring inactive"
                            FontSize="11"
                            Foreground="#A1B5CD"
                            TextWrapping="Wrap"/>

                        <!-- ================================= -->
                        <!-- LATEST SECURITY ASSESSMENT -->
                        <!-- ================================= -->

                        <Border
                            Background="#142135"
                            CornerRadius="12"
                            Padding="15">

                            <StackPanel Spacing="12">

                                <TextBlock
                                    Text="LATEST SECURITY ASSESSMENT"
                                    FontSize="10"
                                    CharacterSpacing="90"
                                    Foreground="#82E2BD"/>

                                <!-- ANALYSIS STATUS -->

                                <TextBlock
                                    x:Name="VisionStatusText"
                                    Text="No analysis yet"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    TextWrapping="Wrap"/>

                                <!-- DOMAIN -->

                                <TextBlock
                                    x:Name="VisionDomainText"
                                    Text="No website analyzed"
                                    FontSize="12"
                                    Foreground="#ACBED4"
                                    TextWrapping="Wrap"/>

                                <!-- RISK BADGE -->

                                <Border
                                    x:Name="VisionRiskBadge"
                                    Background="#34445A"
                                    CornerRadius="10"
                                    Padding="12">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Text="RISK ASSESSMENT"
                                            FontSize="10"
                                            Foreground="#CDD9E8"
                                            VerticalAlignment="Center"/>

                                        <TextBlock
                                            x:Name="VisionRiskBadgeText"
                                            Grid.Column="1"
                                            Text="UNKNOWN"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="White"/>

                                    </Grid>

                                </Border>

                                <!-- RISK SCORE -->

                                <TextBlock
                                    x:Name="VisionScoreText"
                                    Text="--/100"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Foreground="White"/>

                                <!-- SUMMARY -->

                                <TextBlock
                                    x:Name="VisionSummaryText"
                                    Text="Waiting for analysis."
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Foreground="#A8BBD2"/>

                                <!-- OPEN SEPARATE REPORT WINDOW -->

                                <Button
                                    x:Name="VisionDetailsButton"
                                    Content="View analysis details"
                                    Click="VisionDetailsButton_Click"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="#344760"
                                    Foreground="White"
                                    Padding="12,11"
                                    CornerRadius="9"
                                    IsEnabled="False"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

                <!-- ================================= -->
                <!-- WINDOWS SECURITY NOTIFICATIONS -->
                <!-- ================================= -->

                <Border
                    Background="#1E2D43"
                    CornerRadius="13"
                    Padding="16">

                    <StackPanel Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock
                                Text="SECURITY NOTIFICATIONS"
                                FontSize="10"
                                CharacterSpacing="100"
                                Foreground="#82E2BD"
                                VerticalAlignment="Center"/>

                            <Button
                                Grid.Column="1"
                                Content="ⓘ  Info"
                                Click="NotificationInfoButton_Click"
                                Background="#2C415B"
                                Foreground="#BDEBFF"
                                FontSize="11"
                                Padding="10,6"
                                CornerRadius="8"/>

                        </Grid>

                        <!-- NOTIFICATION STATUS -->

                        <TextBlock
                            x:Name="NotificationStatusText"
                            Text="Initializing notifications..."
                            FontSize="12"
                            TextWrapping="Wrap"
                            Foreground="#A8BBD2"/>

                        <!-- TEST NOTIFICATION -->

                        <Button
                            Content="Send test notification"
                            Click="TestNotificationButton_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#344760"
                            Foreground="White"
                            Padding="12,10"
                            CornerRadius="9"/>

                        <TextBlock
                            Text="Automatic Windows notifications are sent for new HIGH and CRITICAL Guardian Vision findings. Repeated alerts are limited."
                            FontSize="10"
                            TextWrapping="Wrap"
                            Foreground="#879CB6"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>
