<Window
    x:Class="Guardian.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#0B1424">

        <NavigationView
            x:Name="RootNavigation"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="225"
            CompactPaneLength="64"
            SelectionChanged="RootNavigation_SelectionChanged"
            Background="#101B2D"
            Foreground="White">

            <!-- NAVIGATION -->

            <NavigationView.MenuItems>

                <NavigationViewItem
                    Content="Dashboard"
                    Tag="Dashboard"
                    IsSelected="True">

                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE80F;"
                            FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>

                </NavigationViewItem>

                <NavigationViewItem
                    Content="Endpoint"
                    Tag="Endpoint">

                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE7F4;"
                            FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>

                </NavigationViewItem>

                <NavigationViewItem
                    Content="Guardian Vision"
                    Tag="Vision">

                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE8A9;"
                            FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>

                </NavigationViewItem>

                <NavigationViewItem
                    Content="Security Alerts"
                    Tag="Alerts">

                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE7BA;"
                            FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>

                </NavigationViewItem>

                <NavigationViewItem
                    Content="History"
                    Tag="History">

                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE81C;"
                            FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>

                </NavigationViewItem>

                <NavigationViewItem
                    Content="Settings"
                    Tag="Settings">

                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="&#xE713;"
                            FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>

                </NavigationViewItem>

            </NavigationView.MenuItems>

            <!-- MAIN CONTENT -->

            <NavigationView.Content>

                <Grid>

                    <!-- DASHBOARD -->

                    <ScrollViewer
                        x:Name="DashboardContent"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <StackPanel
                            Padding="28,24,28,32"
                            Spacing="20">

                            <!-- BRAND HEADER -->

                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <Image
                                    Source="ms-appx:///Assets/GuardianIcon.png"
                                    Width="58"
                                    Height="58"
                                    Stretch="Uniform"/>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="14,0,0,0"
                                    Spacing="3">

                                    <TextBlock
                                        Text="GUARDIAN"
                                        FontSize="25"
                                        FontWeight="Bold"
                                        CharacterSpacing="100"
                                        Foreground="White"/>

                                    <TextBlock
                                        Text="Endpoint Security Intelligence"
                                        FontSize="12"
                                        Foreground="#9DB3CE"/>

                                </StackPanel>

                                <Border
                                    Grid.Column="2"
                                    Background="#153B35"
                                    BorderBrush="#287E68"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="13,8"
                                    VerticalAlignment="Center">

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">

                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            Fill="#48D69B"
                                            VerticalAlignment="Center"/>

                                        <TextBlock
                                            Text="PROTECTION ACTIVE"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            Foreground="#8BE6C2"/>

                                    </StackPanel>

                                </Border>

                            </Grid>

                            <!-- ENDPOINT MONITORING -->

                            <Border
                                Background="#17283E"
                                BorderBrush="#2B4C6D"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="20">

                                <StackPanel Spacing="14">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Text="ENDPOINT MONITORING"
                                            FontSize="11"
                                            CharacterSpacing="110"
                                            Foreground="#77DCC1"
                                            VerticalAlignment="Center"/>

                                        <Button
                                            Grid.Column="1"
                                            Content="ⓘ  Info"
                                            Click="EndpointInfoButton_Click"
                                            Background="#293F59"
                                            Foreground="#BDEBFF"
                                            FontSize="11"
                                            Padding="11,6"
                                            CornerRadius="8"/>

                                    </Grid>

                                    <TextBlock
                                        x:Name="StatusText"
                                        Text="Monitoring starting"
                                        FontSize="21"
                                        FontWeight="SemiBold"
                                        Foreground="White"/>

                                    <TextBlock
                                        x:Name="StatusDescription"
                                        FontSize="13"
                                        Foreground="#A8BAD1"
                                        TextWrapping="Wrap"/>

                                    <!-- METRICS -->

                                    <Grid
                                        ColumnDefinitions="*,*,*"
                                        ColumnSpacing="12">

                                        <Border
                                            Background="#20344E"
                                            CornerRadius="11"
                                            Padding="15">

                                            <StackPanel Spacing="7">

                                                <FontIcon
                                                    Glyph="&#xE7F4;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    Foreground="#75CFFF"
                                                    FontSize="22"/>

                                                <TextBlock
                                                    Text="PROCESSES"
                                                    FontSize="10"
                                                    Foreground="#A6BDD5"/>

                                                <TextBlock
                                                    x:Name="ProcessesText"
                                                    Text="0"
                                                    FontSize="27"
                                                    FontWeight="Bold"
                                                    Foreground="White"/>

                                            </StackPanel>

                                        </Border>

                                        <Border
                                            Grid.Column="1"
                                            Background="#20344E"
                                            CornerRadius="11"
                                            Padding="15">

                                            <StackPanel Spacing="7">

                                                <FontIcon
                                                    Glyph="&#xE774;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    Foreground="#75CFFF"
                                                    FontSize="22"/>

                                                <TextBlock
                                                    Text="TCP CONNECTIONS"
                                                    FontSize="10"
                                                    Foreground="#A6BDD5"/>

                                                <TextBlock
                                                    x:Name="ConnectionsText"
                                                    Text="0"
                                                    FontSize="27"
                                                    FontWeight="Bold"
                                                    Foreground="White"/>

                                            </StackPanel>

                                        </Border>

                                        <Border
                                            Grid.Column="2"
                                            Background="#20344E"
                                            CornerRadius="11"
                                            Padding="15">

                                            <StackPanel Spacing="7">

                                                <FontIcon
                                                    Glyph="&#xE7BA;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    Foreground="#F4B46F"
                                                    FontSize="22"/>

                                                <TextBlock
                                                    Text="ALERTS"
                                                    FontSize="10"
                                                    Foreground="#A6BDD5"/>

                                                <TextBlock
                                                    x:Name="AlertsText"
                                                    Text="0"
                                                    FontSize="27"
                                                    FontWeight="Bold"
                                                    Foreground="White"/>

                                            </StackPanel>

                                        </Border>

                                    </Grid>

                                    <TextBlock
                                        x:Name="LatestEventText"
                                        FontSize="12"
                                        Foreground="#B5C6DA"
                                        TextWrapping="Wrap"
                                        MaxLines="3"/>

                                    <Grid ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            x:Name="UpdatedText"
                                            FontSize="11"
                                            Foreground="#829BB8"
                                            VerticalAlignment="Center"/>

                                        <Button
                                            Grid.Column="1"
                                            Content="Refresh"
                                            Click="RefreshButton_Click"
                                            Background="#304760"
                                            Foreground="White"
                                            Padding="14,7"
                                            CornerRadius="8"/>

                                    </Grid>

                                </StackPanel>

                            </Border>

                            <!-- GUARDIAN VISION -->

                            <Border
                                Background="#17283E"
                                BorderBrush="#2B4C6D"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="20">

                                <StackPanel Spacing="14">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Text="GUARDIAN VISION"
                                            FontSize="11"
                                            CharacterSpacing="110"
                                            Foreground="#77DCC1"
                                            VerticalAlignment="Center"/>

                                        <Button
                                            Grid.Column="1"
                                            Content="ⓘ  Info"
                                            Click="VisionInfoButton_Click"
                                            Background="#293F59"
                                            Foreground="#BDEBFF"
                                            FontSize="11"
                                            Padding="11,6"
                                            CornerRadius="8"/>

                                    </Grid>

                                    <TextBlock
                                        Text="Website Security Analysis"
                                        FontSize="21"
                                        FontWeight="SemiBold"
                                        Foreground="White"/>

                                    <TextBlock
                                        Text="Analyze browser content locally and identify potentially suspicious websites."
                                        FontSize="13"
                                        Foreground="#A8BAD1"
                                        TextWrapping="Wrap"/>

                                    <!-- ACTIONS -->

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="12">

                                        <Button
                                            Content="Analyze selected window"
                                            Click="AnalyzeScreenButton_Click"
                                            Background="#1269A5"
                                            Foreground="White"
                                            Padding="14,13"
                                            CornerRadius="9"/>

                                        <Button
                                            x:Name="ContinuousVisionButton"
                                            Grid.Column="1"
                                            Content="Start continuous monitoring"
                                            Click="ContinuousVisionButton_Click"
                                            Background="#176D5A"
                                            Foreground="White"
                                            Padding="14,13"
                                            CornerRadius="9"/>

                                    </Grid>

                                    <TextBlock
                                        x:Name="ContinuousVisionStatusText"
                                        Text="Continuous monitoring inactive"
                                        FontSize="11"
                                        Foreground="#A6BBD2"
                                        TextWrapping="Wrap"/>

                                    <!-- LATEST ANALYSIS -->

                                    <Border
                                        Background="#101F33"
                                        CornerRadius="12"
                                        Padding="18">

                                        <StackPanel Spacing="12">

                                            <TextBlock
                                                Text="LATEST SECURITY ASSESSMENT"
                                                FontSize="10"
                                                CharacterSpacing="100"
                                                Foreground="#77DCC1"/>

                                            <TextBlock
                                                x:Name="VisionStatusText"
                                                Text="No website analyzed"
                                                FontSize="17"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                x:Name="VisionDomainText"
                                                Text="No active website"
                                                FontSize="12"
                                                Foreground="#A8BAD1"
                                                TextWrapping="Wrap"/>

                                            <Border
                                                x:Name="VisionRiskBadge"
                                                Background="#34445A"
                                                CornerRadius="9"
                                                Padding="13">

                                                <Grid ColumnDefinitions="*,Auto">

                                                    <TextBlock
                                                        Text="RISK ASSESSMENT"
                                                        FontSize="10"
                                                        Foreground="#D0DCEB"/>

                                                    <TextBlock
                                                        x:Name="VisionRiskBadgeText"
                                                        Grid.Column="1"
                                                        Text="UNKNOWN"
                                                        FontWeight="Bold"
                                                        Foreground="White"/>

                                                </Grid>

                                            </Border>

                                            <TextBlock
                                                x:Name="VisionScoreText"
                                                Text="--/100"
                                                FontSize="30"
                                                FontWeight="Bold"
                                                Foreground="White"/>

                                            <TextBlock
                                                x:Name="VisionSummaryText"
                                                Text="Start a screen analysis to view security findings."
                                                FontSize="12"
                                                Foreground="#B4C5D9"
                                                TextWrapping="Wrap"/>

                                            <Button
                                                x:Name="VisionDetailsButton"
                                                Content="View analysis details"
                                                Click="VisionDetailsButton_Click"
                                                Background="#304760"
                                                Foreground="White"
                                                Padding="13,11"
                                                CornerRadius="9"
                                                IsEnabled="False"/>

                                        </StackPanel>

                                    </Border>

                                </StackPanel>

                            </Border>

                            <!-- SECURITY NOTIFICATIONS -->

                            <Border
                                Background="#17283E"
                                BorderBrush="#2B4C6D"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="20">

                                <StackPanel Spacing="12">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <TextBlock
                                            Text="SECURITY NOTIFICATIONS"
                                            FontSize="11"
                                            CharacterSpacing="110"
                                            Foreground="#77DCC1"/>

                                        <Button
                                            Grid.Column="1"
                                            Content="ⓘ  Info"
                                            Click="NotificationInfoButton_Click"
                                            Background="#293F59"
                                            Foreground="#BDEBFF"
                                            FontSize="11"
                                            Padding="11,6"
                                            CornerRadius="8"/>

                                    </Grid>

                                    <TextBlock
                                        x:Name="NotificationStatusText"
                                        Text="Initializing notifications..."
                                        FontSize="12"
                                        Foreground="#A8BAD1"
                                        TextWrapping="Wrap"/>

                                    <Button
                                        Content="Send test notification"
                                        Click="TestNotificationButton_Click"
                                        HorizontalAlignment="Left"
                                        Background="#304760"
                                        Foreground="White"
                                        Padding="15,10"
                                        CornerRadius="9"/>

                                    <TextBlock
                                        Text="Windows notifications are generated for new HIGH and CRITICAL Vision findings."
                                        FontSize="11"
                                        Foreground="#819AB6"
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                            </Border>

                            <!-- FOOTER -->

                            <TextBlock
                                Text="GUARDIAN · ENDPOINT SECURITY INTELLIGENCE"
                                HorizontalAlignment="Center"
                                FontSize="10"
                                CharacterSpacing="90"
                                Foreground="#637D9B"/>

                        </StackPanel>

                    </ScrollViewer>

                    <!-- OTHER MODULES -->

                    <Frame
                        x:Name="ModuleFrame"
                        Visibility="Collapsed"
                        Background="#0B1424"/>

                </Grid>

            </NavigationView.Content>

        </NavigationView>

    </Grid>

</Window>
